<!--
  Nearest Wars. Values come from script.js; texts from lang\<language>.json.
-->
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel.Resources>
        <!-- The coloured WAR / CIVIL WAR / ELECTION tag (rows set war / civil / election to true) -->
        <Style x:Key="KindChip" TargetType="Border">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="5,0,5,1"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource Danger}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding civil}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Warn}"/></DataTrigger>
                <DataTrigger Binding="{Binding election}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Ok}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="KindText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Danger}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding civil}" Value="True"><Setter Property="Foreground" Value="{StaticResource Warn}"/></DataTrigger>
                <DataTrigger Binding="{Binding election}" Value="True"><Setter Property="Foreground" Value="{StaticResource Ok}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- A system name you can select and copy (Ctrl+C) for the galaxy map -->
        <Style x:Key="Copyable" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource HudText}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="ToolTip" Value="{T ui.copy_tip}"/>
        </Style>
    </StackPanel.Resources>

    <!-- Where from, and the search controls -->
    <TextBlock Style="{StaticResource Label}">
        <Run Text="{T ui.from}"/><Run Text="{Binding V[from], Mode=OneWay}" Foreground="{StaticResource Hud}"/>
    </TextBlock>
    <WrapPanel Margin="0,4,0,2">
        <Button Style="{StaticResource HudButton}" Tag="search" Content="{T ui.search}" Margin="0,0,4,4" Foreground="{StaticResource Hud}" FontWeight="SemiBold"/>
        <Button Style="{StaticResource HudButton}" Tag="radius" Content="{Binding V[radiusText]}" Margin="0,0,4,4" ToolTip="{T ui.radius_tip}"/>
        <Button Style="{StaticResource HudButton}" Tag="elections" Content="{Binding V[electionsText]}" Margin="0,0,4,4" ToolTip="{T ui.elections_tip}"/>
        <Button Style="{StaticResource HudButton}" Tag="auto" Content="{Binding V[autoText]}" Margin="0,0,4,4" ToolTip="{T ui.auto_tip}"/>
    </WrapPanel>
    <TextBlock Text="{Binding V[status]}" FontSize="11" Foreground="{StaticResource HudDim}" TextWrapping="Wrap"/>

    <!-- Here: exact, from the journal -->
    <TextBlock Style="{StaticResource Label}" Text="{T ui.here}" Margin="0,8,0,2"/>
    <TextBlock Text="{Binding V[hereNone]}" FontSize="11.5" FontStyle="Italic" Foreground="{StaticResource HudDim}" TextWrapping="Wrap"/>
    <ItemsControl ItemsSource="{Binding V[hereRows]}">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Padding="0,4,0,5">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" FontSize="11.5" Foreground="{StaticResource HudDim}">
                                <Run Text="{T ui.days_won}"/><Run Text="{Binding score, Mode=OneWay}" Foreground="{StaticResource Hud}" FontWeight="Bold"/>
                            </TextBlock>
                            <Border Style="{StaticResource KindChip}" DockPanel.Dock="Left"><TextBlock Style="{StaticResource KindText}" Text="{Binding kind}"/></Border>
                            <TextBlock Text="{Binding status}" FontSize="11" Foreground="{StaticResource HudDim}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock FontSize="12" Foreground="{StaticResource HudText}" TextWrapping="Wrap" Margin="0,2,0,0">
                            <Run Text="{Binding a, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  vs  " Foreground="{StaticResource HudDim}"/><Run Text="{Binding b, Mode=OneWay}" FontWeight="SemiBold"/>
                        </TextBlock>
                        <TextBlock Text="{Binding stakes}" FontSize="11" Foreground="{StaticResource HudDim}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Nearest: from EDSM -->
    <TextBlock Style="{StaticResource Label}" Text="{T ui.nearest}" Margin="0,10,0,2"/>
    <TextBlock Text="{Binding V[nearNote]}" FontSize="11" Foreground="{StaticResource HudDim}" TextWrapping="Wrap" Margin="0,0,0,2"/>
    <ItemsControl ItemsSource="{Binding V[nearRows]}" MaxHeight="300">
        <ItemsControl.Template>
            <ControlTemplate TargetType="ItemsControl">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer>
            </ControlTemplate>
        </ItemsControl.Template>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Padding="0,4,0,5">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ly}" FontSize="12" Foreground="{StaticResource Hud}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource KindChip}" DockPanel.Dock="Left"><TextBlock Style="{StaticResource KindText}" Text="{Binding kind}"/></Border>
                            <TextBox Style="{StaticResource Copyable}" Text="{Binding system, Mode=OneWay}"/>
                        </DockPanel>
                        <TextBlock Text="{Binding sides}" FontSize="11.5" Foreground="{StaticResource HudText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding updated}" FontSize="10.5" Foreground="{StaticResource HudDim}"/>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Seen by you lately: exact, from your journals -->
    <TextBlock Style="{StaticResource Label}" Text="{T ui.seen}" Margin="0,10,0,2"/>
    <ItemsControl ItemsSource="{Binding V[seenRows]}" MaxHeight="240">
        <ItemsControl.Template>
            <ControlTemplate TargetType="ItemsControl">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer>
            </ControlTemplate>
        </ItemsControl.Template>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Padding="0,4,0,5">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ly}" FontSize="12" Foreground="{StaticResource Hud}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource KindChip}" DockPanel.Dock="Left"><TextBlock Style="{StaticResource KindText}" Text="{Binding kind}"/></Border>
                            <TextBox Style="{StaticResource Copyable}" Text="{Binding system, Mode=OneWay}"/>
                        </DockPanel>
                        <TextBlock FontSize="11.5" Foreground="{StaticResource HudText}" TextWrapping="Wrap" Margin="0,2,0,0">
                            <Run Text="{Binding a, Mode=OneWay}"/><Run Text="  vs  " Foreground="{StaticResource HudDim}"/><Run Text="{Binding b, Mode=OneWay}"/>
                            <Run Text="   " /><Run Text="{Binding score, Mode=OneWay}" Foreground="{StaticResource Hud}"/>
                        </TextBlock>
                        <TextBlock FontSize="10.5" Foreground="{StaticResource HudDim}">
                            <Run Text="{Binding status, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding when, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</StackPanel>
