<!-- Squadron: see script.js for where each value comes from. Buttons call the script with Tag="name". -->
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:controls="clr-namespace:EliteCompanion.Controls">

    <StackPanel.Resources>
        <ItemsPanelTemplate x:Key="Wrap"><WrapPanel/></ItemsPanelTemplate>
        <Style x:Key="Pick" TargetType="Button" BasedOn="{StaticResource HudButton}">
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Foreground" Value="{StaticResource HudDim}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding on}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Hud}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Hud}"/>
                    <Setter Property="Background" Value="{StaticResource HudSoft}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Head" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,6,0,3"/>
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource HudDim}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource Small}">
            <Setter Property="FontStyle" Value="Italic"/>
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            </Style.Triggers>
        </Style>
        <!-- a level badge: green when you can make it -->
        <Style x:Key="Lvl" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="Foreground" Value="{StaticResource HudDim}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ok}" Value="True"><Setter Property="Foreground" Value="{StaticResource Good}"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </StackPanel.Resources>

    <TextBlock Text="{Binding V[name]}" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource HudDim}"/><Style.Triggers><DataTrigger Binding="{Binding V[inSquadron]}" Value="True"><Setter Property="Foreground" Value="{StaticResource Hud}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    <TextBlock FontSize="11.5" Margin="0,0,0,4"><Run Text="{Binding V[rank], Mode=OneWay}" Foreground="{StaticResource HudText}"/><Run Text="  "/><Run Text="{Binding V[since], Mode=OneWay}" Foreground="{StaticResource HudDim}"/></TextBlock>
    <TextBlock Style="{StaticResource Note}" Text="{Binding V[empty]}"/>
    <UniformGrid Columns="1" controls:Responsive.WideColumns="2">
        <StackPanel Margin="0,0,8,0">
            <TextBlock Style="{StaticResource Head}" Text="{Binding V[logHead]}"/>
            <ItemsControl ItemsSource="{Binding V[log]}">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <DockPanel Margin="0,0,0,2">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding when}" Style="{StaticResource Small}" Width="70"/>
                    <TextBlock Text="{Binding text}" FontSize="11" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource HudText}"/><Style.Triggers><DataTrigger Binding="{Binding bad}" Value="True"><Setter Property="Foreground" Value="{StaticResource Danger}"/></DataTrigger><DataTrigger Binding="{Binding good}" Value="True"><Setter Property="Foreground" Value="{StaticResource Good}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                </DockPanel>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
        </StackPanel>
        <StackPanel>
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource HudButton}" Tag="clearChat" Content="✕" Padding="5,0" FontSize="10" Margin="0,6,0,0" VerticalAlignment="Bottom" ToolTip="{T ui.clear_chat}"/>
                <TextBlock Style="{StaticResource Head}" Text="{Binding V[chatHead]}"/>
            </DockPanel>
            <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <ItemsControl ItemsSource="{Binding V[chat]}">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,0,0,2">
                    <Run Text="{Binding when, Mode=OneWay}" Foreground="{StaticResource HudDim}"/><Run Text="  "/><Run Text="{Binding from, Mode=OneWay}" Foreground="{StaticResource Hud}" FontWeight="SemiBold"/><Run Text=": " Foreground="{StaticResource HudDim}"/><Run Text="{Binding text, Mode=OneWay}" Foreground="{StaticResource HudText}"/>
                </TextBlock>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
    </ScrollViewer>
        </StackPanel>
    </UniformGrid>
</StackPanel>
