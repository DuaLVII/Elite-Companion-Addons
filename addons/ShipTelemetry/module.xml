<!-- Ship Telemetry: one of the app's own modules, made as an addon so it can be restyled, translated or used as a
     starting point (copy the folder and rename it). The charts draw from the series the app records itself. -->
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:controls="clr-namespace:EliteCompanion.Controls">
    <UniformGrid Columns="3" Height="104">
        <controls:RadialGauge Value="{Binding Game.FuelPercent, Mode=OneWay}" Title="{T gauge_fuel}" Unit="%" Warn="50" Crit="25"/>
        <controls:RadialGauge Value="{Binding Game.HullPercent, Mode=OneWay}" Title="{T gauge_hull}" Unit="%" Warn="70" Crit="40"/>
        <controls:RadialGauge Value="{Binding Game.CargoPercent, Mode=OneWay}" Title="{T gauge_cargo}" Unit="%" Color="#5794F2"/>
    </UniformGrid>
    <!-- Stacked; side by side when the module is wide -->
    <UniformGrid Columns="1" controls:Responsive.WideColumns="2">
        <StackPanel Margin="0,0,4,0">
            <TextBlock Style="{StaticResource Label}" Text="{T ui.fuel_t}" Margin="0,6,0,2"/>
            <controls:TimeSeriesChart Series="fuel" YMin="0" Height="110" ShowLegend="False"/>
        </StackPanel>
        <StackPanel Margin="0,0,4,0">
            <TextBlock Style="{StaticResource Label}" Text="{T ui.hull_cargo}" Margin="0,6,0,2"/>
            <controls:TimeSeriesChart Series="hull,cargo" Height="110"/>
        </StackPanel>
    </UniformGrid>
</StackPanel>
