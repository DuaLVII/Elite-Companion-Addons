<!-- Reputation: see script.js for where each value comes from. -->
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:controls="clr-namespace:EliteCompanion.Controls">

    <StackPanel.Resources>
        <ItemsPanelTemplate x:Key="Wrap"><WrapPanel/></ItemsPanelTemplate>
        <Style x:Key="Head" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,6,0,4"/>
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{StaticResource HudDim}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource Small}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontStyle" Value="Italic"/>
        </Style>
        <!-- the reputation band's colour: hostile red, unfriendly amber, neutral dim, cordial cyan, friendly / allied green -->
        <Style x:Key="BandText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource HudDim}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding tone}" Value="hostile"><Setter Property="Foreground" Value="{StaticResource Danger}"/></DataTrigger>
                <DataTrigger Binding="{Binding tone}" Value="unfriendly"><Setter Property="Foreground" Value="{StaticResource Warn}"/></DataTrigger>
                <DataTrigger Binding="{Binding tone}" Value="cordial"><Setter Property="Foreground" Value="{StaticResource Cyan}"/></DataTrigger>
                <DataTrigger Binding="{Binding tone}" Value="friendly"><Setter Property="Foreground" Value="{StaticResource Good}"/></DataTrigger>
                <DataTrigger Binding="{Binding tone}" Value="allied"><Setter Property="Foreground" Value="{StaticResource Good}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BandBar" TargetType="ProgressBar" BasedOn="{StaticResource Bar}">
            <Setter Property="Foreground" Value="{StaticResource HudDim}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding tone}" Value="hostile"><Setter Property="Foreground" Value="{StaticResource Danger}"/></DataTrigger>
                <DataTrigger Binding="{Binding tone}" Value="unfriendly"><Setter Property="Foreground" Value="{StaticResource Warn}"/></DataTrigger>
                <DataTrigger Binding="{Binding tone}" Value="cordial"><Setter Property="Foreground" Value="{StaticResource Cyan}"/></DataTrigger>
                <DataTrigger Binding="{Binding tone}" Value="friendly"><Setter Property="Foreground" Value="{StaticResource Good}"/></DataTrigger>
                <DataTrigger Binding="{Binding tone}" Value="allied"><Setter Property="Foreground" Value="{StaticResource Good}"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </StackPanel.Resources>

    <TextBlock Style="{StaticResource Note}" Text="{Binding V[empty]}"/>
    <UniformGrid Columns="1" controls:Responsive.WideColumns="2">

        <!-- the superpowers: a bar from -100 (left) to +100 (right), the middle marked -->
        <StackPanel Margin="0,0,10,0">
            <TextBlock Style="{StaticResource Head}" Text="{Binding V[powersHead]}"/>
            <ItemsControl ItemsSource="{Binding V[powers]}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,7">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource BandText}" Text="{Binding band}"/>
                                <TextBlock FontSize="12"><Run Text="{Binding name, Mode=OneWay}" Foreground="{StaticResource HudText}" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding value, Mode=OneWay}" Foreground="{StaticResource HudDim}" FontSize="11"/></TextBlock>
                            </DockPanel>
                            <Grid Margin="0,3,0,1">
                                <ProgressBar Style="{StaticResource BandBar}" Maximum="200" Value="{Binding bar, Mode=OneWay}" Height="6"/>
                                <Border Width="1" HorizontalAlignment="Center" Background="{StaticResource HudText}" Opacity="0.45"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Small}" Text="{Binding next}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- the navies: rank, progress to the next, what the next unlock is, what's unlocked already -->
        <StackPanel>
            <TextBlock Style="{StaticResource Head}" Text="{Binding V[navyHead]}"/>
            <ItemsControl ItemsSource="{Binding V[navy]}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,9">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding pctText}" FontSize="11" Foreground="{StaticResource HudText}"/>
                                <TextBlock FontSize="12"><Run Text="{Binding side, Mode=OneWay}" Foreground="{StaticResource HudDim}" FontSize="11"/><Run Text="  "/><Run Text="{Binding rank, Mode=OneWay}" Foreground="{StaticResource Hud}" FontWeight="Bold"/></TextBlock>
                            </DockPanel>
                            <ProgressBar Maximum="100" Value="{Binding pct, Mode=OneWay}" Height="5" Margin="0,3,0,1">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar" BasedOn="{StaticResource Bar}">
                                        <Setter Property="Foreground" Value="{StaticResource Hud}"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding hasBar}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                            <TextBlock Style="{StaticResource Small}" Text="{Binding toNext}"/>
                            <TextBlock Style="{StaticResource Small}" Text="{Binding nextUnlock}" Foreground="{StaticResource Good}"/>
                            <ItemsControl ItemsSource="{Binding unlocked}" ItemsPanel="{StaticResource Wrap}" Margin="0,3,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderThickness="1" BorderBrush="{StaticResource PanelBorder}" CornerRadius="3" Padding="5,0,5,1" Margin="0,0,4,3">
                                            <TextBlock Text="{Binding text}" FontSize="10.5"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource HudText}"/><Style.Triggers><DataTrigger Binding="{Binding ship}" Value="True"><Setter Property="Foreground" Value="{StaticResource Cyan}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </UniformGrid>

    <!-- promotions, newest first, with what each one unlocked -->
    <TextBlock Style="{StaticResource Head}" Text="{Binding V[histHead]}"/>
    <ItemsControl ItemsSource="{Binding V[hist]}">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <DockPanel Margin="0,0,0,2">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding when}" FontSize="11" Foreground="{StaticResource HudDim}" Width="74"/>
                    <TextBlock FontSize="11" TextWrapping="Wrap"><Run Text="{Binding text, Mode=OneWay}" Foreground="{StaticResource Good}"/><Run Text="  "/><Run Text="{Binding unlocks, Mode=OneWay}" Foreground="{StaticResource HudDim}"/></TextBlock>
                </DockPanel>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</StackPanel>
