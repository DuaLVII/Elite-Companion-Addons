<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Countdown -->
    <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding V[countdown]}" FontSize="30" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource Hud}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding V[phase]}" Value="lockdown"><Setter Property="Foreground" Value="{StaticResource Danger}"/></DataTrigger>
                        <DataTrigger Binding="{Binding V[phase]}" Value="transit"><Setter Property="Foreground" Value="{StaticResource Purple}"/></DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource Value}" FontSize="15" Text="{Binding V[headline]}"/>
            <TextBlock Style="{StaticResource Label}" Text="{Binding V[detail]}" TextWrapping="Wrap"/>
        </StackPanel>
    </DockPanel>
    <ProgressBar Style="{StaticResource Bar}" Value="{Binding V[progress], Mode=OneWay}" Margin="0,6,0,0"/>

    <TextBlock Style="{StaticResource Label}" Text="{T ui.recent_jumps}" Margin="0,10,0,2"/>
    <TextBlock Text="{Binding V[empty]}" FontStyle="Italic" FontSize="12" Foreground="{StaticResource HudDim}" TextWrapping="Wrap"/>
    <ItemsControl ItemsSource="{Binding V[history]}" MaxHeight="200">
        <ItemsControl.Template>
            <ControlTemplate TargetType="ItemsControl">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer>
            </ControlTemplate>
        </ItemsControl.Template>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <DockPanel Margin="0,1">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding note}" FontSize="11" Foreground="{StaticResource HudDim}" Margin="8,0,0,0"/>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding when}" FontSize="11.5" Foreground="{StaticResource HudDim}" Width="86"/>
                    <TextBlock x:Name="Route" Text="{Binding route}" FontSize="12" Foreground="{StaticResource HudText}" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding cancelled}" Value="True">
                        <Setter TargetName="Route" Property="TextDecorations" Value="Strikethrough"/>
                        <Setter TargetName="Route" Property="Foreground" Value="{StaticResource HudDim}"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Style="{StaticResource Label}" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"
               Text="{T ui.confirmed_you_were_aboard_otherwise_the}"/>
</StackPanel>
