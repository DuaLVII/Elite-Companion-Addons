<!-- Tech Broker: each broker unlock with what it takes against what you hold. Tabs and rows are buttons (Tag="tab" / "pick");
     ★ Track keeps an unlock in the Tracked tab and adds it to the shopping list. -->
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:controls="clr-namespace:EliteCompanion.Controls">

    <StackPanel.Resources>
        <ItemsPanelTemplate x:Key="Wrap"><WrapPanel/></ItemsPanelTemplate>
        <Style x:Key="Pick" TargetType="Button" BasedOn="{StaticResource HudButton}">
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Foreground" Value="{StaticResource HudDim}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding on}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Hud}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Hud}"/>
                    <Setter Property="Background" Value="{StaticResource HudSoft}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Head" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,6,0,3"/>
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource HudDim}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource Small}">
            <Setter Property="FontStyle" Value="Italic"/>
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            </Style.Triggers>
        </Style>
        <!-- a level badge: green when you can make it -->
        <Style x:Key="Lvl" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="Foreground" Value="{StaticResource HudDim}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ok}" Value="True"><Setter Property="Foreground" Value="{StaticResource Good}"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </StackPanel.Resources>

    <TextBlock Style="{StaticResource Note}" Text="{Binding V[status]}" Margin="0,0,0,4"/>
    <ItemsControl ItemsSource="{Binding V[tabs]}" ItemsPanel="{StaticResource Wrap}">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Button Style="{StaticResource Pick}" Tag="tab" CommandParameter="{Binding id}" Content="{Binding name}"/>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>

    <UniformGrid Columns="1" controls:Responsive.WideColumns="2">
        <!-- the unlocks -->
        <StackPanel Margin="0,0,8,0">
            <TextBlock Text="{Binding V[summary]}" Style="{StaticResource Small}" Margin="0,0,0,3"/>
            <TextBlock Style="{StaticResource Note}" Text="{Binding V[empty]}"/>
            <ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding V[rows]}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Tag="pick" CommandParameter="{Binding id}" HorizontalContentAlignment="Stretch" Padding="6,2" Margin="0,0,0,2">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource HudButton}">
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding on}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource Hud}"/>
                                                <Setter Property="Background" Value="{StaticResource HudSoft}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding pct}" FontSize="11" Margin="6,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource HudDim}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ready}" Value="True"><Setter Property="Foreground" Value="{StaticResource Good}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding done}" Value="True"><Setter Property="Foreground" Value="{StaticResource Good}"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock DockPanel.Dock="Left" Text="★" FontSize="11" Foreground="{StaticResource Hud}" Margin="0,0,4,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding star}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding name}" FontSize="11.5" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource HudText}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding done}" Value="True"><Setter Property="Foreground" Value="{StaticResource HudDim}"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                                    <ProgressBar Style="{StaticResource Bar}" Height="2" Margin="0,2,0,0" Maximum="1" Value="{Binding p, Mode=OneWay}" Foreground="{StaticResource Hud}"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>

        <!-- the one picked -->
        <StackPanel>
            <TextBlock Text="{Binding V[selTitle]}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Hud}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding V[selSub]}" Style="{StaticResource Small}" Margin="0,0,0,4"/>
            <ItemsControl ItemsSource="{Binding V[selMats]}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,0,0,1">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding have}" FontSize="10.5" Margin="6,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource HudDim}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding short}" Value="True"><Setter Property="Foreground" Value="{StaticResource Danger}"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding kind}" FontSize="9.5" Foreground="{StaticResource Purple}" Margin="6,1,0,0"/>
                            <TextBlock Text="{Binding text}" FontSize="11.5" Foreground="{StaticResource HudText}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding V[selState]}" FontSize="11" Foreground="{StaticResource Good}" TextWrapping="Wrap" Margin="0,3,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding V[hasSel]}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Button Style="{StaticResource HudButton}" Tag="track" Content="{Binding V[trackText]}" Padding="8,1" Margin="0,0,4,0" ToolTip="{T ui.track_tip}"/>
                <Button Style="{StaticResource HudButton}" Tag="unlocked" Content="{Binding V[unlockText]}" Padding="8,1" FontSize="10.5" ToolTip="{T ui.unlocked_tip}"/>
            </StackPanel>

            <TextBlock Style="{StaticResource Head}" Text="{Binding V[shopHead]}" Margin="0,10,0,3"/>
            <TextBlock Style="{StaticResource Note}" Text="{Binding V[shopDone]}" FontStyle="Normal" Foreground="{StaticResource Good}"/>
            <ItemsControl ItemsSource="{Binding V[shop]}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding short}" FontSize="10.5" Foreground="{StaticResource Warn}" Margin="6,0,0,0"/>
                            <TextBlock Text="{Binding text}" FontSize="11" Foreground="{StaticResource HudText}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{T ui.note}" Style="{StaticResource Small}" FontSize="10" Margin="0,8,0,0"/>
        </StackPanel>
    </UniformGrid>
</StackPanel>
