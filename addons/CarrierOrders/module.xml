<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel.Resources>
        <!-- One order: commodity · amount · price · total -->
        <DataTemplate x:Key="OrderRow">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="62"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="58"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Name" Grid.Column="0" Text="{Binding commodity}" FontSize="12" Foreground="{StaticResource HudText}"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding set}"/>
                <TextBlock Grid.Column="1" Text="{Binding amount}" FontSize="12" Foreground="{StaticResource HudDim}" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="2" Text="{Binding price}" FontSize="12" Foreground="{StaticResource HudText}" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="3" Text="{Binding total}" FontSize="11.5" Foreground="{StaticResource HudDim}" HorizontalAlignment="Right"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding blackMarket}" Value="True">
                    <Setter TargetName="Name" Property="Foreground" Value="{StaticResource Purple}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </StackPanel.Resources>

    <TextBlock Text="{Binding V[empty]}" FontStyle="Italic" FontSize="12" Foreground="{StaticResource HudDim}" TextWrapping="Wrap"/>

    <TextBlock Text="{Binding V[buyHeader]}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Good}" Margin="0,0,0,2"/>
    <ItemsControl ItemsSource="{Binding V[buy]}" ItemTemplate="{StaticResource OrderRow}" MaxHeight="200">
        <ItemsControl.Template>
            <ControlTemplate TargetType="ItemsControl">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer>
            </ControlTemplate>
        </ItemsControl.Template>
    </ItemsControl>

    <TextBlock Text="{Binding V[sellHeader]}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Hud}" Margin="0,10,0,2"/>
    <ItemsControl ItemsSource="{Binding V[sell]}" ItemTemplate="{StaticResource OrderRow}" MaxHeight="200">
        <ItemsControl.Template>
            <ControlTemplate TargetType="ItemsControl">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer>
            </ControlTemplate>
        </ItemsControl.Template>
    </ItemsControl>

    <TextBlock Style="{StaticResource Label}" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap"
               Text="{T ui.secure_warehouse_black_market_orders_as}"/>
</StackPanel>
