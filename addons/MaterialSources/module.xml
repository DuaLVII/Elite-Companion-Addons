<!-- Material Sources: how full you are of each material (lowest first), what's running low, and where each comes from.
     Category chips and rows are buttons (Tag="cat" / "pick"); the "low" share is a text box bound to V[lowPct]. -->
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:controls="clr-namespace:EliteCompanion.Controls">

    <StackPanel.Resources>
        <ItemsPanelTemplate x:Key="Wrap"><WrapPanel/></ItemsPanelTemplate>
        <Style x:Key="Pick" TargetType="Button" BasedOn="{StaticResource HudButton}">
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Foreground" Value="{StaticResource HudDim}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding on}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Hud}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Hud}"/>
                    <Setter Property="Background" Value="{StaticResource HudSoft}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Head" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,6,0,3"/>
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource HudDim}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource Small}">
            <Setter Property="FontStyle" Value="Italic"/>
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            </Style.Triggers>
        </Style>
        <!-- a level badge: green when you can make it -->
        <Style x:Key="Lvl" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="Foreground" Value="{StaticResource HudDim}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ok}" Value="True"><Setter Property="Foreground" Value="{StaticResource Good}"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </StackPanel.Resources>

    <TextBlock Style="{StaticResource Note}" Text="{Binding V[status]}" Margin="0,0,0,4"/>
    <ItemsControl ItemsSource="{Binding V[cats]}" ItemsPanel="{StaticResource Wrap}">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Button Style="{StaticResource Pick}" Tag="cat" CommandParameter="{Binding id}" Content="{Binding name}"/>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>

    <UniformGrid Columns="1" controls:Responsive.WideColumns="2">
        <!-- the materials, lowest first -->
        <StackPanel Margin="0,0,8,0">
            <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding V[rows]}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Tag="pick" CommandParameter="{Binding id}" HorizontalContentAlignment="Stretch" Padding="6,1" Margin="0,0,0,2">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource HudButton}">
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding on}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource Hud}"/>
                                                <Setter Property="Background" Value="{StaticResource HudSoft}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding info}" Style="{StaticResource Small}" Margin="6,0,0,0"/>
                                        <TextBlock Text="{Binding name}" FontSize="11.5" Foreground="{StaticResource HudText}" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <ProgressBar Height="2" Margin="0,2,0,0" Maximum="1" Value="{Binding p, Mode=OneWay}">
                                        <ProgressBar.Style>
                                            <Style TargetType="ProgressBar" BasedOn="{StaticResource Bar}">
                                                <Setter Property="Foreground" Value="{StaticResource Good}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding low}" Value="True"><Setter Property="Foreground" Value="{StaticResource Warn}"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ProgressBar.Style>
                                    </ProgressBar>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <DockPanel Margin="0,6,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" ToolTip="{T ui.low_tip}">
                    <TextBox Style="{StaticResource SearchBox}" Width="34" HorizontalContentAlignment="Center"
                             Text="{Binding V[lowPct], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="%" FontSize="11" Foreground="{StaticResource HudDim}" VerticalAlignment="Center" Margin="3,0,0,0"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Head}" Text="{Binding V[lowHead]}" Margin="0,2,0,3"/>
            </DockPanel>
            <TextBlock Style="{StaticResource Note}" Text="{Binding V[lowNone]}"/>
            <ItemsControl ItemsSource="{Binding V[low]}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Tag="pick" CommandParameter="{Binding id}" HorizontalContentAlignment="Stretch" Padding="4,0" Margin="0,0,0,1"
                                Background="Transparent" BorderBrush="Transparent" Style="{StaticResource HudButton}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding pct}" FontSize="11" Foreground="{StaticResource Warn}" Margin="6,0,0,0"/>
                                <TextBlock Text="{Binding text}" FontSize="11" Foreground="{StaticResource HudText}" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- where it comes from -->
        <StackPanel>
            <TextBlock Text="{Binding V[selTitle]}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Hud}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding V[selSub]}" Style="{StaticResource Small}" Margin="0,0,0,4"/>
            <TextBlock Style="{StaticResource Head}" Text="{T ui.where}"/>
            <ItemsControl ItemsSource="{Binding V[sources]}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock DockPanel.Dock="Left" Text="•" Foreground="{StaticResource Hud}" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding text}" FontSize="11.5" Foreground="{StaticResource HudText}" TextWrapping="Wrap"/>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource Note}" Text="{Binding V[trade]}" FontStyle="Normal" Foreground="{StaticResource Good}" Margin="0,2,0,0"/>
            <TextBlock Text="{T ui.note}" Style="{StaticResource Small}" FontSize="10" Margin="0,8,0,0"/>
        </StackPanel>
    </UniformGrid>
</StackPanel>
