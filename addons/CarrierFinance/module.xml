<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <TextBlock Text="{Binding V[empty]}" FontStyle="Italic" FontSize="12" Foreground="{StaticResource HudDim}" TextWrapping="Wrap"/>

    <TextBlock Style="{StaticResource Label}" Text="{T ui.carrier_balance}"/>
    <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding V[balance]}">
        <TextBlock.Style>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Good}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding V[low]}" Value="True"><Setter Property="Foreground" Value="{StaticResource Danger}"/></DataTrigger>
                </Style.Triggers>
            </Style>
        </TextBlock.Style>
    </TextBlock>
    <TextBlock Text="{Binding V[lowText]}" Foreground="{StaticResource Danger}" FontSize="11.5" FontWeight="Bold" TextWrapping="Wrap"/>

    <UniformGrid Columns="2" Margin="0,6,0,0">
        <StackPanel>
            <TextBlock Style="{StaticResource Label}" Text="{T ui.reserved}"/>
            <TextBlock Style="{StaticResource Value}" FontSize="13" Text="{Binding V[reserve]}"/>
        </StackPanel>
        <StackPanel>
            <TextBlock Style="{StaticResource Label}" Text="{T ui.available}"/>
            <TextBlock Style="{StaticResource Value}" FontSize="13" Text="{Binding V[available]}"/>
        </StackPanel>
    </UniformGrid>

    <!-- Alert level: typed here, read by the script -->
    <DockPanel Margin="0,8,0,0">
        <TextBlock Style="{StaticResource Label}" Text="{T ui.alert_below_cr}" VerticalAlignment="Center"/>
        <TextBox Style="{StaticResource SearchBox}" Text="{Binding V[threshold], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="{T ui.warn_me_when_the_carrier_balance}"/>
    </DockPanel>

    <TextBlock Style="{StaticResource Label}" Text="{T ui.tax_rates}" Margin="0,10,0,2"/>
    <ItemsControl ItemsSource="{Binding V[taxes]}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <DockPanel Margin="0,1,10,1">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding rate}" FontSize="12" Foreground="{StaticResource Hud}"/>
                    <TextBlock Text="{Binding service}" FontSize="12" Foreground="{StaticResource HudText}" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Style="{StaticResource Label}" Text="{T ui.transfers}" Margin="0,10,0,2"/>
    <ItemsControl ItemsSource="{Binding V[transfers]}" MaxHeight="170">
        <ItemsControl.Template>
            <ControlTemplate TargetType="ItemsControl">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer>
            </ControlTemplate>
        </ItemsControl.Template>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <DockPanel Margin="0,1">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding balance}" FontSize="11.5" Foreground="{StaticResource HudDim}" Margin="8,0,0,0"/>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding when}" FontSize="11.5" Foreground="{StaticResource HudDim}" Width="86"/>
                    <TextBlock x:Name="Amount" Text="{Binding amount}" FontSize="12" Foreground="{StaticResource Danger}"/>
                </DockPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding incoming}" Value="True">
                        <Setter TargetName="Amount" Property="Foreground" Value="{StaticResource Good}"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Style="{StaticResource Label}" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap">
        <Run Text="{Binding V[updated], Mode=OneWay}"/><Run Text="{T ui.weekly_upkeep_isn_t_written_to}"/>
    </TextBlock>
</StackPanel>
