<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Species in progress -->
    <TextBlock Style="{StaticResource Value}" FontSize="16" Text="{Binding V[species]}"/>
    <TextBlock Style="{StaticResource Label}" Text="{Binding V[variant]}"/>

    <DockPanel Margin="0,6,0,0">
        <!-- three dots: filled for each sample taken -->
        <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding V[dots]}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Ellipse x:Name="Dot" Width="12" Height="12" Margin="0,0,5,0" Stroke="{StaticResource Good}" StrokeThickness="1.5" Fill="Transparent"/>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding done}" Value="True">
                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Good}"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Style="{StaticResource Label}" Text="{Binding V[sampleText]}" VerticalAlignment="Center" Margin="4,0,0,0"/>
    </DockPanel>

    <!-- Distance from earlier samples -->
    <DockPanel Margin="0,8,0,0">
        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Label}" Text="{Binding V[need]}" VerticalAlignment="Bottom" Margin="8,0,0,4"/>
        <TextBlock Text="{Binding V[distance]}" FontSize="26" FontWeight="SemiBold">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource Warn}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding V[farEnough]}" Value="True"><Setter Property="Foreground" Value="{StaticResource Good}"/></DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </DockPanel>
    <TextBlock Text="{Binding V[advice]}" FontSize="12" Foreground="{StaticResource HudText}" TextWrapping="Wrap"/>

    <!-- This body's biology -->
    <Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,6,0,0">
        <StackPanel>
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Label}" Text="{Binding V[bodySignals]}"/>
                <TextBlock Style="{StaticResource Label}" Foreground="{StaticResource Hud}" Text="{Binding V[bodyName]}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
            <ItemsControl ItemsSource="{Binding V[genera]}" Margin="0,3,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Chip" CornerRadius="3" Padding="6,1" Margin="0,0,4,3" Background="#22FFFFFF"
                                ToolTip="{Binding range}">
                            <TextBlock x:Name="Text" Text="{Binding genus}" FontSize="11" Foreground="{StaticResource HudText}"/>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding done}" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#3373BF69"/>
                                <Setter TargetName="Text" Property="Foreground" Value="{StaticResource Good}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>

    <!-- Unsold samples -->
    <DockPanel Margin="0,8,0,2">
        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Label}" Text="{Binding V[earned]}"/>
        <TextBlock Style="{StaticResource Label}" Text="{Binding V[unsoldText]}"/>
    </DockPanel>
    <ItemsControl ItemsSource="{Binding V[unsold]}" MaxHeight="160">
        <ItemsControl.Template>
            <ControlTemplate TargetType="ItemsControl">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer>
            </ControlTemplate>
        </ItemsControl.Template>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <DockPanel Margin="0,1">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding value}" FontSize="12" Foreground="{StaticResource Good}" Margin="8,0,0,0"/>
                    <TextBlock FontSize="12" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding species, Mode=OneWay}" Foreground="{StaticResource HudText}"/>
                        <Run Text="{Binding body, Mode=OneWay}" Foreground="{StaticResource HudDim}" FontSize="10.5"/>
                    </TextBlock>
                </DockPanel>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Style="{StaticResource Label}" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"
               Text="{T ui.values_are_learnt_from_your_own}"/>
</StackPanel>
