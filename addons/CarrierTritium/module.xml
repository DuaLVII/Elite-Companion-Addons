<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:controls="clr-namespace:EliteCompanion.Controls">

    <TextBlock Text="{Binding V[empty]}" FontStyle="Italic" FontSize="12" Foreground="{StaticResource HudDim}" TextWrapping="Wrap"/>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- Tank gauge (percent of 1,000 t) -->
        <controls:RadialGauge Grid.Column="0" Value="{Binding V[percent], Mode=OneWay}" Title="Tank" Unit="%" Warn="30" Crit="15" Height="100"/>
        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Ok}">
                <Run Text="{Binding V[level], Mode=OneWay}"/>
                <Run Text="{Binding V[ofTank], Mode=OneWay}" FontSize="12" Foreground="{StaticResource HudDim}"/>
            </TextBlock>
            <UniformGrid Columns="3" Margin="0,4,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="{T ui.range}"/>
                    <TextBlock Style="{StaticResource Value}" FontSize="12.5" Text="{Binding V[range]}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="{T ui.per_jump}"/>
                    <TextBlock Style="{StaticResource Value}" FontSize="12.5" Text="{Binding V[cost]}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="{T ui.jumps_left}"/>
                    <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Hud}" Text="{Binding V[jumpsLeft]}"/>
                </StackPanel>
            </UniformGrid>
        </StackPanel>
    </Grid>
    <TextBlock Style="{StaticResource Label}" FontSize="10" Text="{Binding V[costNote]}" TextWrapping="Wrap"/>
    <TextBlock Style="{StaticResource Label}" FontSize="10" Text="{Binding V[stale]}" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding V[low]}" Foreground="{StaticResource Danger}" FontWeight="Bold" FontSize="12"/>

    <TextBlock Style="{StaticResource Label}" Text="{T ui.deposits}" Margin="0,8,0,2"/>
    <ItemsControl ItemsSource="{Binding V[deposits]}" MaxHeight="160">
        <ItemsControl.Template>
            <ControlTemplate TargetType="ItemsControl">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer>
            </ControlTemplate>
        </ItemsControl.Template>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <DockPanel Margin="0,1">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding total}" FontSize="11.5" Foreground="{StaticResource HudDim}" Margin="8,0,0,0"/>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding when}" FontSize="11.5" Foreground="{StaticResource HudDim}" Width="86"/>
                    <TextBlock Text="{Binding amount}" FontSize="12" Foreground="{StaticResource Good}"/>
                </DockPanel>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</StackPanel>
