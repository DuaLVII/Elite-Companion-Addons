<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DockPanel>
        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Label}" Text="{Binding V[state]}" VerticalAlignment="Center"/>
        <TextBlock Style="{StaticResource Value}" FontSize="15" Text="{Binding V[tripTitle]}"/>
    </DockPanel>

    <!-- Live gauges -->
    <UniformGrid Columns="3" Margin="0,6,0,0">
        <StackPanel>
            <TextBlock Style="{StaticResource Label}" Text="{T ui.speed}"/>
            <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Hud}" Text="{Binding V[speed]}"/>
        </StackPanel>
        <StackPanel>
            <TextBlock Style="{StaticResource Label}" Text="{T ui.fuel}"/>
            <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Ok}" Text="{Binding V[fuel]}"/>
        </StackPanel>
        <StackPanel>
            <TextBlock Style="{StaticResource Label}" Text="{T ui.cargo}"/>
            <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource HudText}" Text="{Binding V[cargo]}"/>
        </StackPanel>
    </UniformGrid>

    <!-- Control states as chips: lit when on -->
    <ItemsControl ItemsSource="{Binding V[flags]}" Margin="0,6,0,0">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border x:Name="Chip" CornerRadius="3" Padding="6,1" Margin="0,0,4,3" Background="#14FFFFFF">
                    <TextBlock x:Name="Text" Text="{Binding name}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource HudDim}"/>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding on}" Value="True">
                        <Setter TargetName="Chip" Property="Background" Value="#33FF9830"/>
                        <Setter TargetName="Text" Property="Foreground" Value="{StaticResource Hud}"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Trip -->
    <UniformGrid Columns="3" Margin="0,8,0,0">
        <StackPanel>
            <TextBlock Style="{StaticResource Label}" Text="{T ui.time_out}"/>
            <TextBlock Style="{StaticResource Value}" FontSize="13" Text="{Binding V[time]}"/>
        </StackPanel>
        <StackPanel>
            <TextBlock Style="{StaticResource Label}" Text="{T ui.driven}"/>
            <TextBlock Style="{StaticResource Value}" FontSize="13" Text="{Binding V[distance]}"/>
        </StackPanel>
        <StackPanel>
            <TextBlock Style="{StaticResource Label}" Text="{T ui.top_speed}"/>
            <TextBlock Style="{StaticResource Value}" FontSize="13" Text="{Binding V[topSpeed]}"/>
        </StackPanel>
    </UniformGrid>

    <TextBlock Style="{StaticResource Label}" Text="{Binding V[materialsText]}" Margin="0,10,0,2"/>
    <ItemsControl ItemsSource="{Binding V[materials]}" MaxHeight="200">
        <ItemsControl.Template>
            <ControlTemplate TargetType="ItemsControl">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer>
            </ControlTemplate>
        </ItemsControl.Template>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <DockPanel Margin="0,1">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding count}" FontSize="12" Foreground="{StaticResource Hud}" Margin="8,0,0,0"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding category}" FontSize="10" Foreground="{StaticResource HudDim}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding name}" FontSize="12" Foreground="{StaticResource HudText}" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</StackPanel>
