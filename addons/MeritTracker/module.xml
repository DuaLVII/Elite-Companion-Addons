<!-- Merits: this cycle / today / session, rate, graph, what earned them and recent gains. -->
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:controls="clr-namespace:EliteCompanion.Controls">

    <DockPanel>
        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Label}" Text="{Binding V[tick]}" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding V[power]}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Purple}" TextTrimming="CharacterEllipsis"/>
    </DockPanel>

    <UniformGrid Columns="4" Margin="0,6,0,4">
        <StackPanel>
            <TextBlock Style="{StaticResource Label}" Text="{T ui.this_cycle}"/>
            <TextBlock FontSize="22" Foreground="{StaticResource Hud}" Text="{Binding V[cycle]}"/>
        </StackPanel>
        <StackPanel>
            <TextBlock Style="{StaticResource Label}" Text="{T ui.today}"/>
            <TextBlock FontSize="22" Foreground="{StaticResource HudText}" Text="{Binding V[today]}"/>
        </StackPanel>
        <StackPanel>
            <TextBlock Style="{StaticResource Label}" Text="{T ui.session}"/>
            <TextBlock FontSize="22" Foreground="{StaticResource HudText}" Text="{Binding V[session]}"/>
        </StackPanel>
        <StackPanel>
            <TextBlock Style="{StaticResource Label}" Text="{T ui.rate}"/>
            <TextBlock FontSize="16" Margin="0,4,0,0" Foreground="{StaticResource Good}" Text="{Binding V[rate]}"/>
        </StackPanel>
    </UniformGrid>

    <controls:TimeSeriesChart Series="addon.pp.cycle" Height="90" Margin="0,2,0,6"/>

    <!-- What earned them this cycle -->
    <StackPanel>
        <TextBlock Style="{StaticResource Label}" Text="{T ui.this_cycle_by_activity}"/>
        <ItemsControl ItemsSource="{Binding V[acts]}" Margin="0,2,0,6">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="0,1">
                        <TextBlock controls:Responsive.HideBelow="Compact" DockPanel.Dock="Right" Text="{Binding pct}" Width="36" TextAlignment="Right" FontSize="11" Foreground="{StaticResource HudDim}"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding text}" Width="60" TextAlignment="Right" FontSize="12" Foreground="{StaticResource HudText}"/>
                        <Grid controls:Responsive.HideBelow="Compact" DockPanel.Dock="Right" Width="80" Height="4" Margin="6,0,0,0" VerticalAlignment="Center" Background="{StaticResource PanelBorder}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding fill}"/>
                                <ColumnDefinition Width="{Binding rest}"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource Purple}"/>
                        </Grid>
                        <TextBlock Text="{Binding name}" FontSize="12" Foreground="{StaticResource HudText}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>

    <TextBlock Style="{StaticResource Label}" Text="{T ui.recent}"/>
    <TextBlock Text="{Binding V[empty]}" FontStyle="Italic" FontSize="11.5" Foreground="{StaticResource HudDim}" TextWrapping="Wrap"/>
    <ItemsControl ItemsSource="{Binding V[recent]}" MaxHeight="220">
        <ItemsControl.Template>
            <ControlTemplate TargetType="ItemsControl">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer>
            </ControlTemplate>
        </ItemsControl.Template>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <DockPanel Margin="0,1">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding when}" Width="82" FontSize="11" Foreground="{StaticResource HudDim}"/>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding n}" Width="58" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Good}"/>
                    <TextBlock controls:Responsive.HideBelow="Compact" DockPanel.Dock="Right" Text="{Binding system}" FontSize="11" Foreground="{StaticResource HudDim}" Margin="6,0,0,0"/>
                    <TextBlock Text="{Binding what}" FontSize="12" Foreground="{StaticResource HudText}" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</StackPanel>
