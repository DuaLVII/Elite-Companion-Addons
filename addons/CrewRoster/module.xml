<!-- CrewRoster: see script.js for where each value comes from. Buttons call the script with Tag="name". -->
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:controls="clr-namespace:EliteCompanion.Controls">

    <StackPanel.Resources>
        <ItemsPanelTemplate x:Key="Wrap"><WrapPanel/></ItemsPanelTemplate>
        <Style x:Key="Pick" TargetType="Button" BasedOn="{StaticResource HudButton}">
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Foreground" Value="{StaticResource HudDim}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding on}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Hud}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Hud}"/>
                    <Setter Property="Background" Value="{StaticResource HudSoft}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Head" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,6,0,3"/>
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource HudDim}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource Small}">
            <Setter Property="FontStyle" Value="Italic"/>
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            </Style.Triggers>
        </Style>
        <!-- a level badge: green when you can make it -->
        <Style x:Key="Lvl" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="Foreground" Value="{StaticResource HudDim}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ok}" Value="True"><Setter Property="Foreground" Value="{StaticResource Good}"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </StackPanel.Resources>

    <TextBlock Text="{Binding V[summary]}" Style="{StaticResource Small}" Margin="0,0,0,4"/>
    <TextBlock Style="{StaticResource Note}" Text="{Binding V[empty]}"/>
    <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <ItemsControl ItemsSource="{Binding V[rows]}">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border CornerRadius="3" Padding="8,5" Margin="0,0,0,5" BorderThickness="1">
                    <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/><Style.Triggers><DataTrigger Binding="{Binding active}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Hud}"/><Setter Property="Background" Value="{StaticResource HudSoft}"/></DataTrigger></Style.Triggers></Style></Border.Style>
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding role}" FontSize="10.5" FontWeight="SemiBold" Margin="6,0,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource HudDim}"/><Style.Triggers><DataTrigger Binding="{Binding active}" Value="True"><Setter Property="Foreground" Value="{StaticResource Hud}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                            <TextBlock Text="{Binding name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource HudText}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <TextBlock FontSize="11"><Run Text="{Binding rank, Mode=OneWay}" Foreground="{StaticResource Cyan}"/><Run Text="  "/><Run Text="{Binding faction, Mode=OneWay}" Foreground="{StaticResource HudDim}"/></TextBlock>
                        <TextBlock Text="{Binding info}" Style="{StaticResource Small}" FontSize="10.5"/>
                        <TextBlock FontSize="10.5"><Run Text="{Binding paid, Mode=OneWay}" Foreground="{StaticResource HudText}"/><Run Text="  "/><Run Text="{Binding today, Mode=OneWay}" Foreground="{StaticResource Good}"/></TextBlock>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
    </ScrollViewer>
    <TextBlock Style="{StaticResource Head}" Text="{Binding V[firedHead]}"/>
    <ItemsControl ItemsSource="{Binding V[fired]}">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <TextBlock Text="{Binding text}" Style="{StaticResource Small}" FontSize="10.5"/>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</StackPanel>
