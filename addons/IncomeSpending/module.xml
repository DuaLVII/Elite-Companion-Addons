<!-- Income & Spending: one of the app's own modules, made as an addon so it can be restyled, translated or used as a
     starting point (copy the folder and rename it). The charts draw from the series the app records itself. -->
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:controls="clr-namespace:EliteCompanion.Controls">
    <UniformGrid Columns="1" controls:Responsive.WideColumns="2">
        <StackPanel Margin="0,0,4,6">
            <TextBlock Style="{StaticResource Label}" Text="{T ui.income_by_source}" Margin="0,0,0,2"/>
            <controls:DonutChart Key="income" Unit="cr" Height="120"/>
        </StackPanel>
        <StackPanel Margin="0,0,4,0">
            <TextBlock Style="{StaticResource Label}" Text="{T ui.spending}" Margin="0,0,0,2"/>
            <controls:DonutChart Key="spend" Unit="cr" Height="120"/>
        </StackPanel>
    </UniformGrid>
    <TextBlock Style="{StaticResource Label}" Text="{T ui.profit_per_market_sale}" Margin="0,8,0,2"/>
    <controls:ColumnChart Key="tradeprofit" Unit="cr" Color="#73BF69" Height="80"/>
</StackPanel>
