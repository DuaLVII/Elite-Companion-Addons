<!-- Blueprint Planner: pick the engineering you're after, + Add it, and see the materials it takes against what you have.
     Drop-downs show V[xNames] with SelectedIndex bound to V[xIdx]; buttons call the script with Tag="name". -->
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel.Resources>
        <Style x:Key="Head" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,6,0,3"/>
        </Style>
        <Style x:Key="Pick" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="MaxDropDownHeight" Value="320"/>
        </Style>
        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource HudDim}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- hidden when its text is empty -->
        <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource Small}">
            <Setter Property="FontStyle" Value="Italic"/>
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            </Style.Triggers>
        </Style>
    </StackPanel.Resources>

    <!-- what to plan -->
    <ComboBox Style="{StaticResource Pick}" ItemsSource="{Binding V[typeNames]}" SelectedIndex="{Binding V[typeIdx], Mode=TwoWay}" ToolTip="{T ui.module}"/>
    <ComboBox Style="{StaticResource Pick}" ItemsSource="{Binding V[bpNames]}" SelectedIndex="{Binding V[bpIdx], Mode=TwoWay}" ToolTip="{T ui.blueprint}"/>
    <Grid Margin="0,0,0,4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="44"/>
        </Grid.ColumnDefinitions>
        <ComboBox Grid.Column="0" Style="{StaticResource Pick}" Margin="0" ItemsSource="{Binding V[fromNames]}" SelectedIndex="{Binding V[fromIdx], Mode=TwoWay}" ToolTip="{T ui.from}"/>
        <TextBlock Grid.Column="1" Text="→" Margin="5,0" VerticalAlignment="Center" Foreground="{StaticResource HudDim}"/>
        <ComboBox Grid.Column="2" Style="{StaticResource Pick}" Margin="0" ItemsSource="{Binding V[toNames]}" SelectedIndex="{Binding V[toIdx], Mode=TwoWay}" ToolTip="{T ui.to}"/>
        <TextBlock Grid.Column="3" Text="{T ui.rolls}" Margin="8,0,4,0" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource HudDim}"/>
        <TextBox Grid.Column="4" Style="{StaticResource SearchBox}" Text="{Binding V[rolls], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="{T ui.rolls_tip}" HorizontalContentAlignment="Center"/>
    </Grid>
    <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource HudButton}" Tag="add" Content="{T ui.add}" Padding="10,2" Margin="6,0,0,4"/>
        <ComboBox Style="{StaticResource Pick}" ItemsSource="{Binding V[expNames]}" SelectedIndex="{Binding V[expIdx], Mode=TwoWay}" ToolTip="{T ui.experimental}"/>
    </DockPanel>

    <!-- the plan -->
    <DockPanel>
        <Button DockPanel.Dock="Right" Tag="clearDone" Content="{T ui.clear_done}" Padding="7,1" Margin="0,4,0,2" FontSize="10.5">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource HudButton}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding V[hasDone]}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        <TextBlock Style="{StaticResource Head}" Text="{T ui.plan}"/>
    </DockPanel>
    <TextBlock Style="{StaticResource Note}" Text="{Binding V[empty]}"/>
    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding V[plan]}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="0,1,0,5">
                        <Button DockPanel.Dock="Right" Style="{StaticResource HudButton}" Tag="remove" CommandParameter="{Binding id}" Content="✕"
                                Padding="5,0" Margin="4,0,0,0" VerticalAlignment="Top" ToolTip="{T ui.remove}"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource HudButton}" Tag="roll" CommandParameter="{Binding id}" Content="−1"
                                Padding="5,0" Margin="4,0,0,0" VerticalAlignment="Top" ToolTip="{T ui.roll_tip}"/>
                        <StackPanel>
                            <TextBlock Text="{Binding title}" FontSize="12" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource HudText}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding done}" Value="True"><Setter Property="Foreground" Value="{StaticResource HudDim}"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding detail}" Style="{StaticResource Small}"/>
                            <TextBlock Text="{Binding next}" FontSize="11" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Warn}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ready}" Value="True"><Setter Property="Foreground" Value="{StaticResource Good}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding next}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>

    <!-- the materials it takes -->
    <DockPanel>
        <CheckBox DockPanel.Dock="Right" Content="{T ui.only_short}" IsChecked="{Binding V[onlyShort], Mode=TwoWay}" FontSize="10.5"
                  Foreground="{StaticResource HudDim}" VerticalAlignment="Center" Margin="0,4,0,0"/>
        <TextBlock Style="{StaticResource Head}" Text="{T ui.materials}"/>
    </DockPanel>
    <TextBlock Text="{Binding V[summary]}" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,3">
        <TextBlock.Style>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Good}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding V[summaryLevel]}" Value="short"><Setter Property="Foreground" Value="{StaticResource Warn}"/></DataTrigger>
                    <DataTrigger Binding="{Binding V[summary]}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                </Style.Triggers>
            </Style>
        </TextBlock.Style>
    </TextBlock>
    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding V[mats]}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="0,1,0,2">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding status}" Width="62" TextAlignment="Right" FontSize="11.5">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Good}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding short}" Value="True"><Setter Property="Foreground" Value="{StaticResource Warn}"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock DockPanel.Dock="Right" FontSize="11.5" Foreground="{StaticResource HudDim}" Margin="6,0,0,0">
                            <Run Text="{Binding have, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding need, Mode=OneWay}"/>
                        </TextBlock>
                        <Border DockPanel.Dock="Right" CornerRadius="3" Padding="4,0" Margin="6,0,0,0" VerticalAlignment="Center"
                                BorderBrush="{StaticResource PanelBorder}" BorderThickness="1">
                            <TextBlock Text="{Binding grade}" FontSize="9.5" Foreground="{StaticResource HudDim}"/>
                        </Border>
                        <TextBlock Text="{Binding name}" FontSize="12" Foreground="{StaticResource HudText}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>

    <!-- trades for what's short -->
    <StackPanel>
        <StackPanel.Style>
            <Style TargetType="StackPanel">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding V[trades].Count}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                    <DataTrigger Binding="{Binding V[trades]}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                </Style.Triggers>
            </Style>
        </StackPanel.Style>
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0" ToolTip="{T ui.reserve_tip}">
                <TextBlock Text="{T ui.keep}" FontSize="10.5" Foreground="{StaticResource HudDim}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox Style="{StaticResource SearchBox}" Width="34" HorizontalContentAlignment="Center"
                         Text="{Binding V[reserve], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="%" FontSize="10.5" Foreground="{StaticResource HudDim}" VerticalAlignment="Center" Margin="3,0,0,0"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Head}" Text="{T ui.trades}"/>
        </DockPanel>
        <ItemsControl ItemsSource="{Binding V[trades]}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,1,0,4">
                        <TextBlock Text="{Binding text}" FontSize="11.5" Foreground="{StaticResource HudText}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding sub}" Style="{StaticResource Note}" FontStyle="Normal"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</StackPanel>
