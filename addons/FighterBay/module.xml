<!-- FighterBay: see script.js for where each value comes from. Buttons call the script with Tag="name". -->
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:controls="clr-namespace:EliteCompanion.Controls">

    <StackPanel.Resources>
        <ItemsPanelTemplate x:Key="Wrap"><WrapPanel/></ItemsPanelTemplate>
        <Style x:Key="Pick" TargetType="Button" BasedOn="{StaticResource HudButton}">
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Foreground" Value="{StaticResource HudDim}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding on}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Hud}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Hud}"/>
                    <Setter Property="Background" Value="{StaticResource HudSoft}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Head" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,6,0,3"/>
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource HudDim}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource Small}">
            <Setter Property="FontStyle" Value="Italic"/>
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            </Style.Triggers>
        </Style>
        <!-- a level badge: green when you can make it -->
        <Style x:Key="Lvl" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="Foreground" Value="{StaticResource HudDim}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ok}" Value="True"><Setter Property="Foreground" Value="{StaticResource Good}"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </StackPanel.Resources>

    <TextBlock Text="{Binding V[status]}" FontSize="16" FontWeight="Bold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Good}"/><Style.Triggers><DataTrigger Binding="{Binding V[statusKind]}" Value="out"><Setter Property="Foreground" Value="{StaticResource Hud}"/></DataTrigger><DataTrigger Binding="{Binding V[statusKind]}" Value="rebuild"><Setter Property="Foreground" Value="{StaticResource Warn}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    <TextBlock Text="{Binding V[where]}" Style="{StaticResource Note}" FontStyle="Normal" Foreground="{StaticResource HudText}"/>
    <ItemsControl ItemsSource="{Binding V[fighters]}">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <DockPanel Margin="0,1,0,1">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding when}" Style="{StaticResource Small}" Margin="6,0,0,0"/>
                    <TextBlock Text="{Binding text}" FontSize="11.5" Foreground="{StaticResource Hud}"/>
                </DockPanel>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
    <ItemsControl ItemsSource="{Binding V[rebuilds]}">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <DockPanel Margin="0,1,0,1">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding when}" Style="{StaticResource Small}" Margin="6,0,0,0"/>
                    <TextBlock Text="{Binding text}" FontSize="11.5" Foreground="{StaticResource Warn}"/>
                </DockPanel>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="{Binding V[stats]}" Style="{StaticResource Small}" Margin="0,4,0,0"/>
    <TextBlock Style="{StaticResource Note}" Text="{Binding V[note]}"/>
    <TextBlock Style="{StaticResource Head}" Text="{T ui.log}"/>
    <ItemsControl ItemsSource="{Binding V[log]}">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <DockPanel Margin="0,0,0,2">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding when}" Style="{StaticResource Small}" Width="40"/>
                    <TextBlock Text="{Binding text}" FontSize="11" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource HudText}"/><Style.Triggers><DataTrigger Binding="{Binding bad}" Value="True"><Setter Property="Foreground" Value="{StaticResource Danger}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                </DockPanel>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</StackPanel>
