<!-- WingPanel: see script.js for where each value comes from. Buttons call the script with Tag="name". -->
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:controls="clr-namespace:EliteCompanion.Controls">

    <StackPanel.Resources>
        <ItemsPanelTemplate x:Key="Wrap"><WrapPanel/></ItemsPanelTemplate>
        <Style x:Key="Pick" TargetType="Button" BasedOn="{StaticResource HudButton}">
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Foreground" Value="{StaticResource HudDim}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding on}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Hud}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Hud}"/>
                    <Setter Property="Background" Value="{StaticResource HudSoft}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Head" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,6,0,3"/>
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource HudDim}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource Small}">
            <Setter Property="FontStyle" Value="Italic"/>
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            </Style.Triggers>
        </Style>
        <!-- a level badge: green when you can make it -->
        <Style x:Key="Lvl" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="Foreground" Value="{StaticResource HudDim}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ok}" Value="True"><Setter Property="Foreground" Value="{StaticResource Good}"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </StackPanel.Resources>

    <TextBlock Text="{Binding V[title]}" FontSize="14" FontWeight="Bold" Margin="0,0,0,1"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource HudDim}"/><Style.Triggers><DataTrigger Binding="{Binding V[inWing]}" Value="True"><Setter Property="Foreground" Value="{StaticResource Hud}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    <TextBlock Text="{Binding V[since]}" Style="{StaticResource Note}" FontStyle="Normal" Margin="0,0,0,4"/>
    <ItemsControl ItemsSource="{Binding V[members]}">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <DockPanel Margin="0,1,0,3">
                    <Button DockPanel.Dock="Right" Style="{StaticResource HudButton}" Tag="copy" CommandParameter="{Binding name}" Content="⧉" Padding="5,0" FontSize="10" Margin="4,0,0,0" ToolTip="{T ui.copy_tip}"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding joined}" Style="{StaticResource Small}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock FontSize="12.5" Foreground="{StaticResource HudText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"><Run Text="◆ " Foreground="{StaticResource Hud}"/><Run Text="{Binding name, Mode=OneWay}"/></TextBlock>
                </DockPanel>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Style="{StaticResource Note}" Text="{Binding V[empty]}"/>
    <TextBlock Style="{StaticResource Head}" Text="{Binding V[invitesHead]}"/>
    <ItemsControl ItemsSource="{Binding V[invites]}">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <DockPanel Margin="0,0,0,2">
                    <Button DockPanel.Dock="Right" Style="{StaticResource HudButton}" Tag="copy" CommandParameter="{Binding name}" Content="⧉" Padding="5,0" FontSize="10" Margin="4,0,0,0" ToolTip="{T ui.copy_tip}"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding when}" Style="{StaticResource Small}" Margin="6,0,0,0"/>
                    <TextBlock Text="{Binding name}" FontSize="11.5" Foreground="{StaticResource HudText}"/>
                </DockPanel>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
    <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource HudButton}" Tag="clearChat" Content="✕" Padding="5,0" FontSize="10" Margin="0,6,0,0" VerticalAlignment="Bottom" ToolTip="{T ui.clear_chat}"/>
        <TextBlock Style="{StaticResource Head}" Text="{Binding V[chatHead]}"/>
    </DockPanel>
    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <ItemsControl ItemsSource="{Binding V[chat]}">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,0,0,2">
                    <Run Text="{Binding when, Mode=OneWay}" Foreground="{StaticResource HudDim}"/><Run Text="  "/><Run Text="{Binding from, Mode=OneWay}" Foreground="{StaticResource Hud}" FontWeight="SemiBold"/><Run Text=": " Foreground="{StaticResource HudDim}"/><Run Text="{Binding text, Mode=OneWay}" Foreground="{StaticResource HudText}"/>
                </TextBlock>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
    </ScrollViewer>
    <TextBlock Style="{StaticResource Head}" Text="{Binding V[historyHead]}"/>
    <ItemsControl ItemsSource="{Binding V[history]}">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <DockPanel Margin="0,0,0,2">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding when}" Style="{StaticResource Small}" Width="40"/>
                    <TextBlock Text="{Binding text}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource HudText}"/>
                </DockPanel>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</StackPanel>
