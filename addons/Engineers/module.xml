<!-- Engineers: every ship engineer, your status with each, where they are, what they do. Click one for how to unlock
     them and everything they do; ⧉ copies their system for the galaxy map. Buttons call the script with Tag="name". -->
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:controls="clr-namespace:EliteCompanion.Controls">

    <StackPanel.Resources>
        <ItemsPanelTemplate x:Key="Wrap"><WrapPanel/></ItemsPanelTemplate>
        <Style x:Key="Pick" TargetType="Button" BasedOn="{StaticResource HudButton}">
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Foreground" Value="{StaticResource HudDim}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding on}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Hud}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Hud}"/>
                    <Setter Property="Background" Value="{StaticResource HudSoft}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- status chip: green unlocked, yellow invited / met, dim known / not met, red barred -->
        <Style x:Key="Status" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="6,0,6,1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding status}" Value="Unlocked"><Setter Property="BorderBrush" Value="{StaticResource Good}"/><Setter Property="Background" Value="{StaticResource GoodSoft}"/></DataTrigger>
                <DataTrigger Binding="{Binding status}" Value="Invited"><Setter Property="BorderBrush" Value="{StaticResource Warn}"/></DataTrigger>
                <DataTrigger Binding="{Binding status}" Value="Acquainted"><Setter Property="BorderBrush" Value="{StaticResource Warn}"/></DataTrigger>
                <DataTrigger Binding="{Binding status}" Value="Barred"><Setter Property="BorderBrush" Value="{StaticResource Danger}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HideEmpty" TargetType="TextBlock">
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            </Style.Triggers>
        </Style>
    </StackPanel.Resources>

    <TextBlock Text="{Binding V[summary]}" FontSize="11.5" Foreground="{StaticResource HudDim}" Margin="0,0,0,5" TextWrapping="Wrap"/>

    <!-- who can do… -->
    <ComboBox ItemsSource="{Binding V[mods]}" DisplayMemberPath="name" SelectedValuePath="id"
              SelectedValue="{Binding V[mod], Mode=TwoWay}" Margin="0,0,0,5" HorizontalAlignment="Stretch"/>

    <ItemsControl ItemsSource="{Binding V[filters]}" ItemsPanel="{StaticResource Wrap}">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Button Style="{StaticResource Pick}" Tag="filter" CommandParameter="{Binding id}" Content="{Binding name}"/>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Text="{Binding V[empty]}" Style="{StaticResource HideEmpty}" FontStyle="Italic" FontSize="11.5" Foreground="{StaticResource HudDim}"/>

    <ScrollViewer MaxHeight="460" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding V[rows]}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Padding="0,4,0,5">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource HudButton}" Tag="copy" CommandParameter="{Binding system}" Content="⧉"
                                        Padding="5,0" Margin="6,0,0,0" VerticalAlignment="Top" ToolTip="{T ui.copy_tip}"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding distText}" FontSize="11.5" Foreground="{StaticResource HudText}" Margin="6,1,0,0" VerticalAlignment="Top"/>
                                <!-- the engineer (click: how to unlock, everything they do) -->
                                <Button Tag="open" CommandParameter="{Binding name}" Cursor="Hand" Focusable="False" HorizontalContentAlignment="Stretch">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button"><ContentPresenter/></ControlTemplate>
                                    </Button.Template>
                                    <StackPanel Background="Transparent">
                                        <WrapPanel>
                                            <TextBlock Text="{Binding name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource HudText}" Margin="0,0,6,0"/>
                                            <Border Style="{StaticResource Status}">
                                                <TextBlock Text="{Binding statusText}" FontSize="10" Foreground="{StaticResource HudText}"/>
                                            </Border>
                                            <TextBlock Text="{Binding rank}" Style="{StaticResource HideEmpty}" FontSize="11" Foreground="{StaticResource Hud}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding where}" FontSize="10.5" Foreground="{StaticResource HudDim}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding does}" Style="{StaticResource HideEmpty}" FontSize="10.5" Foreground="{StaticResource Hud}" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </Button>
                            </DockPanel>
                            <TextBlock Text="{Binding needs}" Style="{StaticResource HideEmpty}" FontSize="10.5" Foreground="{StaticResource Warn}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            <!-- details -->
                            <StackPanel Margin="0,4,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding open}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock FontSize="10.5" Foreground="{StaticResource HudText}" TextWrapping="Wrap"><Run Text="{T ui.find}" Foreground="{StaticResource HudDim}"/><Run Text="{Binding discover, Mode=OneWay}"/></TextBlock>
                                <TextBlock FontSize="10.5" Foreground="{StaticResource HudText}" TextWrapping="Wrap"><Run Text="{T ui.meet}" Foreground="{StaticResource HudDim}"/><Run Text="{Binding meet, Mode=OneWay}"/></TextBlock>
                                <TextBlock FontSize="10.5" Foreground="{StaticResource HudText}" TextWrapping="Wrap"><Run Text="{T ui.unlock}" Foreground="{StaticResource HudDim}"/><Run Text="{Binding unlock, Mode=OneWay}"/></TextBlock>
                                <TextBlock FontSize="10.5" Foreground="{StaticResource HudText}" TextWrapping="Wrap"><Run Text="{T ui.rep}" Foreground="{StaticResource HudDim}"/><Run Text="{Binding rep, Mode=OneWay}"/></TextBlock>
                                <TextBlock FontSize="10.5" Foreground="{StaticResource Hud}" TextWrapping="Wrap" Margin="0,3,0,0"><Run Text="{T ui.does}" Foreground="{StaticResource HudDim}"/><Run Text="{Binding all, Mode=OneWay}"/></TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</StackPanel>
