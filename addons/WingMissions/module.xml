<!-- WingMissions: see script.js for where each value comes from. Buttons call the script with Tag="name". -->
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:controls="clr-namespace:EliteCompanion.Controls">

    <StackPanel.Resources>
        <ItemsPanelTemplate x:Key="Wrap"><WrapPanel/></ItemsPanelTemplate>
        <Style x:Key="Pick" TargetType="Button" BasedOn="{StaticResource HudButton}">
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Foreground" Value="{StaticResource HudDim}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding on}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Hud}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Hud}"/>
                    <Setter Property="Background" Value="{StaticResource HudSoft}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Head" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,6,0,3"/>
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource HudDim}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource Small}">
            <Setter Property="FontStyle" Value="Italic"/>
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            </Style.Triggers>
        </Style>
        <!-- a level badge: green when you can make it -->
        <Style x:Key="Lvl" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="Foreground" Value="{StaticResource HudDim}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ok}" Value="True"><Setter Property="Foreground" Value="{StaticResource Good}"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </StackPanel.Resources>

    <DockPanel>
        <Button DockPanel.Dock="Right" Tag="clearDone" Content="{T ui.clear_done}" Padding="7,1" FontSize="10.5" Margin="0,0,0,4">
            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource HudButton}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding V[hasDone]}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
        </Button>
        <TextBlock Text="{Binding V[summary]}" Style="{StaticResource Small}" VerticalAlignment="Center"/>
    </DockPanel>
    <TextBlock Style="{StaticResource Note}" Text="{Binding V[empty]}"/>
    <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <ItemsControl ItemsSource="{Binding V[rows]}">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border CornerRadius="3" Padding="8,5" Margin="0,0,0,5" BorderThickness="1" BorderBrush="{StaticResource PanelBorder}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding pct}" FontSize="13" FontWeight="Bold" Margin="6,0,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Hud}"/><Style.Triggers><DataTrigger Binding="{Binding full}" Value="True"><Setter Property="Foreground" Value="{StaticResource Good}"/></DataTrigger><DataTrigger Binding="{Binding done}" Value="True"><Setter Property="Foreground" Value="{StaticResource HudDim}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                            <TextBlock Text="{Binding title}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource HudText}"/><Style.Triggers><DataTrigger Binding="{Binding done}" Value="True"><Setter Property="Foreground" Value="{StaticResource HudDim}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                        </DockPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource HudButton}" Tag="copy" CommandParameter="{Binding system}" Content="⧉" Padding="5,0" FontSize="10" ToolTip="{T ui.copy_system}"/>
                            <TextBlock Text="{Binding sub}" Style="{StaticResource Small}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <ProgressBar Style="{StaticResource Bar}" Height="6" Maximum="1" Value="{Binding p, Mode=OneWay}" Margin="0,4,0,3" Foreground="{StaticResource Hud}"/>
                        <TextBlock Text="{Binding stats}" Style="{StaticResource Small}" FontSize="10.5"/>
                        <TextBlock Text="{Binding left}" FontSize="10.5"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Warn}"/><Style.Triggers><DataTrigger Binding="{Binding done}" Value="True"><Setter Property="Foreground" Value="{StaticResource HudDim}"/></DataTrigger><DataTrigger Binding="{Binding full}" Value="True"><Setter Property="Foreground" Value="{StaticResource Good}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
    </ScrollViewer>
</StackPanel>
