<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel.Resources>
        <!-- The arrow: ▲ = straight ahead, turned by the angle the script works out -->
        <Style x:Key="Arrow" TargetType="TextBlock">
            <Setter Property="Text" Value="▲"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.55"/>
        </Style>
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
    </StackPanel.Resources>

    <TextBlock Style="{StaticResource Label}" Text="{Binding V[where]}" Margin="0,0,0,4"/>

    <!-- Ship -->
    <DockPanel Style="{StaticResource Row}">
        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Arrow}" Foreground="{StaticResource Hud}"
                   Visibility="{Binding V[shipVisible], Converter={StaticResource BoolToVis}}">
            <TextBlock.RenderTransform><RotateTransform Angle="{Binding V[shipAngle]}"/></TextBlock.RenderTransform>
        </TextBlock>
        <StackPanel VerticalAlignment="Center" Margin="6,0,0,0">
            <TextBlock FontSize="13">
                <Run Text="{Binding V[shipText], Mode=OneWay}" Foreground="{StaticResource HudDim}" FontSize="11"/>
                <Run Text="{Binding V[shipDistance], Mode=OneWay}" Foreground="{StaticResource HudText}" FontSize="18" FontWeight="SemiBold"/>
            </TextBlock>
            <TextBlock Style="{StaticResource Label}" Text="{Binding V[shipDetail]}"/>
        </StackPanel>
    </DockPanel>

    <!-- SRV -->
    <DockPanel Style="{StaticResource Row}">
        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Arrow}" Foreground="{StaticResource Ok}"
                   Visibility="{Binding V[srvVisible], Converter={StaticResource BoolToVis}}">
            <TextBlock.RenderTransform><RotateTransform Angle="{Binding V[srvAngle]}"/></TextBlock.RenderTransform>
        </TextBlock>
        <StackPanel VerticalAlignment="Center" Margin="6,0,0,0">
            <TextBlock FontSize="13">
                <Run Text="{Binding V[srvText], Mode=OneWay}" Foreground="{StaticResource HudDim}" FontSize="11"/>
                <Run Text="{Binding V[srvDistance], Mode=OneWay}" Foreground="{StaticResource HudText}" FontSize="18" FontWeight="SemiBold"/>
            </TextBlock>
            <TextBlock Style="{StaticResource Label}" Text="{Binding V[srvDetail]}"/>
        </StackPanel>
    </DockPanel>

    <!-- Marker -->
    <DockPanel Style="{StaticResource Row}">
        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Arrow}" Foreground="{StaticResource Purple}"
                   Visibility="{Binding V[markVisible], Converter={StaticResource BoolToVis}}">
            <TextBlock.RenderTransform><RotateTransform Angle="{Binding V[markAngle]}"/></TextBlock.RenderTransform>
        </TextBlock>
        <StackPanel VerticalAlignment="Center" Margin="6,0,0,0">
            <TextBlock FontSize="13">
                <Run Text="{Binding V[markText], Mode=OneWay}" Foreground="{StaticResource HudDim}" FontSize="11"/>
                <Run Text="{Binding V[markDistance], Mode=OneWay}" Foreground="{StaticResource HudText}" FontSize="18" FontWeight="SemiBold"/>
            </TextBlock>
            <TextBlock Style="{StaticResource Label}" Text="{Binding V[markDetail]}"/>
        </StackPanel>
    </DockPanel>

    <!-- These write into the script's values; the script acts on them and unticks them -->
    <WrapPanel Margin="0,6,0,0">
        <CheckBox Content="{T ui.mark_this_spot}" IsChecked="{Binding V[markNow], Mode=TwoWay}"
                  Foreground="{StaticResource HudText}" FontSize="11.5" Margin="0,0,14,0"/>
        <CheckBox Content="{T ui.clear_marker}" IsChecked="{Binding V[clearMark], Mode=TwoWay}"
                  Foreground="{StaticResource HudDim}" FontSize="11.5"/>
    </WrapPanel>
    <TextBlock Style="{StaticResource Label}" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap"
               Text="{T ui.straight_ahead_distances_are_along_the}"/>
</StackPanel>
