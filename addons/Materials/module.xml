<!-- Materials: every ship material against its grade's cap. Buttons call the script with Tag="name". -->
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:controls="clr-namespace:EliteCompanion.Controls">

    <StackPanel.Resources>
        <ItemsPanelTemplate x:Key="Wrap"><WrapPanel/></ItemsPanelTemplate>
        <!-- a toggle-looking button: lit when its item's "on" is true -->
        <Style x:Key="Pick" TargetType="Button" BasedOn="{StaticResource HudButton}">
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Foreground" Value="{StaticResource HudDim}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding on}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Hud}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Hud}"/>
                    <Setter Property="Background" Value="{StaticResource HudSoft}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- the fill bar: green → yellow when nearly full → red when full -->
        <Style x:Key="Fill" TargetType="ProgressBar" BasedOn="{StaticResource Bar}">
            <Setter Property="Height" Value="3"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Foreground" Value="{StaticResource Good}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding level}" Value="near"><Setter Property="Foreground" Value="{StaticResource Warn}"/></DataTrigger>
                <DataTrigger Binding="{Binding level}" Value="full"><Setter Property="Foreground" Value="{StaticResource Danger}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Count" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource HudText}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding level}" Value="empty"><Setter Property="Foreground" Value="{StaticResource HudDim}"/></DataTrigger>
                <DataTrigger Binding="{Binding level}" Value="near"><Setter Property="Foreground" Value="{StaticResource Warn}"/></DataTrigger>
                <DataTrigger Binding="{Binding level}" Value="full"><Setter Property="Foreground" Value="{StaticResource Danger}"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </StackPanel.Resources>

    <!-- full / nearly full -->
    <TextBlock Text="{Binding V[warn]}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4">
        <TextBlock.Style>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Warn}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding V[warnLevel]}" Value="full"><Setter Property="Foreground" Value="{StaticResource Danger}"/></DataTrigger>
                    <DataTrigger Binding="{Binding V[warn]}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                </Style.Triggers>
            </Style>
        </TextBlock.Style>
    </TextBlock>

    <!-- raw / manufactured / encoded -->
    <ItemsControl ItemsSource="{Binding V[tabs]}" ItemsPanel="{StaticResource Wrap}">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Button Style="{StaticResource Pick}" Tag="tab" CommandParameter="{Binding id}" Content="{Binding name}"/>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- what to show · sort -->
    <DockPanel Margin="0,0,0,4">
        <Button DockPanel.Dock="Right" Style="{StaticResource HudButton}" Tag="sort" Content="{Binding V[sortText]}" Padding="7,2" Margin="4,0,0,4" VerticalAlignment="Top"/>
        <ItemsControl ItemsSource="{Binding V[filters]}" ItemsPanel="{StaticResource Wrap}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource Pick}" Tag="filter" CommandParameter="{Binding id}" Content="{Binding name}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>

    <TextBlock Text="{Binding V[empty]}" FontStyle="Italic" FontSize="11.5" Foreground="{StaticResource HudDim}" TextWrapping="Wrap">
        <TextBlock.Style>
            <Style TargetType="TextBlock">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding V[empty]}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                </Style.Triggers>
            </Style>
        </TextBlock.Style>
    </TextBlock>

    <!-- the materials, in their trader groups -->
    <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding V[sections]}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="{Binding title}" FontSize="10" FontWeight="SemiBold" Margin="0,2,0,2">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Label}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding title}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,1,0,3" ToolTip="{Binding tip}" Background="Transparent">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Count}" Text="{Binding count}" Margin="8,0,0,0"/>
                                            <Border DockPanel.Dock="Right" CornerRadius="3" Padding="4,0" Margin="6,0,0,0" VerticalAlignment="Center"
                                                    BorderBrush="{StaticResource PanelBorder}" BorderThickness="1">
                                                <TextBlock Text="{Binding grade}" FontSize="9.5" Foreground="{StaticResource HudDim}"/>
                                            </Border>
                                            <TextBlock Text="{Binding name}" FontSize="12" Foreground="{StaticResource HudText}" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <ProgressBar Style="{StaticResource Fill}" Value="{Binding pct, Mode=OneWay}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>

    <TextBlock Text="{Binding V[when]}" FontSize="10" Foreground="{StaticResource HudDim}" Margin="0,4,0,0" controls:Responsive.HideBelow="Normal"/>
</StackPanel>
