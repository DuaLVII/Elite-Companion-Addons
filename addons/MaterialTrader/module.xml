<!-- Material Trader: what to give a trader for what you need, and what to do with what's nearly full.
     The drop-down shows V[wantNames] with SelectedIndex bound to V[wantIdx]; buttons call the script with Tag="name". -->
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel.Resources>
        <ItemsPanelTemplate x:Key="Wrap"><WrapPanel/></ItemsPanelTemplate>
        <Style x:Key="Pick" TargetType="Button" BasedOn="{StaticResource HudButton}">
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Foreground" Value="{StaticResource HudDim}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding on}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Hud}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Hud}"/>
                    <Setter Property="Background" Value="{StaticResource HudSoft}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Head" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,8,0,3"/>
        </Style>
        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource HudDim}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource Small}">
            <Setter Property="FontStyle" Value="Italic"/>
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            </Style.Triggers>
        </Style>
    </StackPanel.Resources>

    <TextBlock Style="{StaticResource Note}" Text="{Binding V[status]}" Margin="0,0,0,4"/>

    <!-- raw / manufactured / encoded -->
    <ItemsControl ItemsSource="{Binding V[cats]}" ItemsPanel="{StaticResource Wrap}">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Button Style="{StaticResource Pick}" Tag="cat" CommandParameter="{Binding id}" Content="{Binding name}"/>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- I need … -->
    <TextBlock Style="{StaticResource Head}" Text="{T ui.need}" Margin="0,2,0,3"/>
    <ComboBox ItemsSource="{Binding V[wantNames]}" SelectedIndex="{Binding V[wantIdx], Mode=TwoWay}" MaxDropDownHeight="340" Margin="0,0,0,4"/>
    <DockPanel Margin="0,0,0,2">
        <TextBlock DockPanel.Dock="Left" Text="{T ui.amount}" FontSize="11" Foreground="{StaticResource HudDim}" VerticalAlignment="Center" Margin="0,0,4,0"/>
        <TextBox DockPanel.Dock="Left" Style="{StaticResource SearchBox}" Width="48" HorizontalContentAlignment="Center"
                 Text="{Binding V[amount], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <Button DockPanel.Dock="Left" Style="{StaticResource HudButton}" Tag="fillUp" Content="{T ui.fill_up}" Padding="7,1" Margin="4,0,0,0"
                FontSize="10.5" ToolTip="{T ui.fill_up_tip}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" ToolTip="{T ui.reserve_tip}">
            <TextBlock Text="{T ui.keep}" FontSize="11" Foreground="{StaticResource HudDim}" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox Style="{StaticResource SearchBox}" Width="34" HorizontalContentAlignment="Center"
                     Text="{Binding V[reserve], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="%" FontSize="11" Foreground="{StaticResource HudDim}" VerticalAlignment="Center" Margin="3,0,0,0"/>
        </StackPanel>
    </DockPanel>

    <!-- the trades -->
    <TextBlock Text="{Binding V[headline]}" FontSize="11.5" Foreground="{StaticResource HudText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
    <TextBlock Text="{Binding V[trader]}" Style="{StaticResource Note}" FontStyle="Normal" Margin="0,0,0,4"/>
    <TextBlock Style="{StaticResource Note}" Text="{Binding V[noOptions]}"/>
    <ItemsControl ItemsSource="{Binding V[options]}">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border CornerRadius="3" Padding="7,4" Margin="0,0,0,4" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding best}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource Hud}"/>
                                    <Setter Property="Background" Value="{StaticResource HudSoft}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource HudText}">
                            <Run Text="{T ui.give}"/><Run Text=" "/><Run Text="{Binding give, Mode=OneWay}" FontWeight="Bold"/><Run Text=" "/><Run Text="{Binding from, Mode=OneWay}"/>
                            <Run Text="  →  " Foreground="{StaticResource HudDim}"/><Run Text="{T ui.get}"/><Run Text=" "/><Run Text="{Binding get, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource Good}"/>
                            <Run Text=" "/><Run Text="{Binding note, Mode=OneWay}" Foreground="{StaticResource Warn}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding fromInfo}" Style="{StaticResource Small}" FontSize="10.5"/>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- nearly full -->
    <TextBlock Style="{StaticResource Head}" Text="{T ui.near}"/>
    <TextBlock Style="{StaticResource Note}" Text="{Binding V[nearEmpty]}"/>
    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding V[near]}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,1,0,4">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding pct}" FontSize="11.5" Margin="6,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Warn}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding full}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding name}" FontSize="12" Foreground="{StaticResource HudText}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <TextBlock Text="{Binding text}" Style="{StaticResource Small}"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</StackPanel>
