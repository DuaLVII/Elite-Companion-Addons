<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <TextBlock Text="{Binding V[context]}" FontSize="13" Foreground="{StaticResource Hud}" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding V[warnings]}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Danger}" TextWrapping="Wrap"/>

    <!-- Vitals (only while on foot) -->
    <StackPanel Margin="0,6,0,0">
        <StackPanel.Style>
            <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding V[onFoot]}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                </Style.Triggers>
            </Style>
        </StackPanel.Style>
        <DockPanel>
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Label}" Text="{Binding V[oxygen], StringFormat={}{0}%}"/>
            <TextBlock Style="{StaticResource Label}" Text="{T ui.oxygen}"/>
        </DockPanel>
        <ProgressBar Style="{StaticResource Bar}" Foreground="{StaticResource Ok}" Value="{Binding V[oxygen], Mode=OneWay}"/>
        <DockPanel>
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Label}" Text="{Binding V[health], StringFormat={}{0}%}"/>
            <TextBlock Style="{StaticResource Label}" Text="{T ui.health}"/>
        </DockPanel>
        <ProgressBar Style="{StaticResource Bar}" Foreground="{StaticResource Good}" Value="{Binding V[health], Mode=OneWay}"/>
        <UniformGrid Columns="3" Margin="0,6,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource Label}" Text="{T ui.temp}"/>
                <TextBlock Style="{StaticResource Value}" FontSize="13" Text="{Binding V[temp]}"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Style="{StaticResource Label}" Text="{T ui.gravity}"/>
                <TextBlock Style="{StaticResource Value}" FontSize="13" Text="{Binding V[gravity]}"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Style="{StaticResource Label}" Text="{T ui.weapon}"/>
                <TextBlock Style="{StaticResource Value}" FontSize="13" Text="{Binding V[weapon]}"/>
            </StackPanel>
        </UniformGrid>
    </StackPanel>

    <!-- Suit and weapons -->
    <TextBlock Style="{StaticResource Label}" Text="{T ui.loadout}" Margin="0,10,0,1"/>
    <TextBlock FontSize="13" Foreground="{StaticResource HudText}" TextTrimming="CharacterEllipsis">
        <Run Text="{Binding V[suit], Mode=OneWay}" FontWeight="SemiBold"/>
        <Run Text="{Binding V[loadoutName], Mode=OneWay}" Foreground="{StaticResource HudDim}"/>
    </TextBlock>
    <TextBlock Text="{Binding V[suitMods]}" FontSize="10.5" Foreground="{StaticResource Purple}" TextWrapping="Wrap"/>
    <ItemsControl ItemsSource="{Binding V[weapons]}" Margin="0,3,0,0">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <StackPanel Margin="0,1">
                    <TextBlock Text="{Binding name}" FontSize="12" Foreground="{StaticResource HudText}"/>
                    <TextBlock Text="{Binding mods}" FontSize="10.5" Foreground="{StaticResource Purple}" Margin="10,0,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Consumables as chips -->
    <TextBlock Style="{StaticResource Label}" Text="{T ui.consumables}" Margin="0,10,0,2"/>
    <ItemsControl ItemsSource="{Binding V[consumables]}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border x:Name="Chip" CornerRadius="3" Padding="6,1" Margin="0,0,4,3" Background="#22FFFFFF">
                    <TextBlock FontSize="11.5" Foreground="{StaticResource HudText}">
                        <Run Text="{Binding name, Mode=OneWay}"/> <Run x:Name="Count" Text="{Binding count, Mode=OneWay}" Foreground="{StaticResource Hud}"/>
                    </TextBlock>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding out}" Value="True">
                        <Setter TargetName="Chip" Property="Background" Value="#33F2495C"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Backpack -->
    <TextBlock Style="{StaticResource Label}" Text="{Binding V[backpackText]}" Margin="0,8,0,2"/>
    <TextBlock Text="{Binding V[backpackEmpty]}" FontStyle="Italic" FontSize="11.5" Foreground="{StaticResource HudDim}"/>
    <ItemsControl ItemsSource="{Binding V[backpack]}" MaxHeight="160">
        <ItemsControl.Template>
            <ControlTemplate TargetType="ItemsControl">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer>
            </ControlTemplate>
        </ItemsControl.Template>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <DockPanel Margin="0,1">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding count}" FontSize="12" Foreground="{StaticResource Hud}" Margin="8,0,0,0"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding kind}" FontSize="10" Foreground="{StaticResource HudDim}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding name}" FontSize="12" Foreground="{StaticResource HudText}" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Style="{StaticResource Label}" FontSize="10.5" Text="{Binding V[locker]}" Margin="0,8,0,0" TextWrapping="Wrap"/>
</StackPanel>
