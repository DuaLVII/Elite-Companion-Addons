<!--
  Ship Loadout: the built-in Ship module rebuilt as an addon, plus the loadout.

  The top half binds straight to the app's game state (Game.…), with no script needed.
  The loadout comes from script.js reading the journal's Loadout event.
-->
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel.Resources>
        <!-- One fitted module: "5A Frame Shift Drive · G5 Increased Range" -->
        <DataTemplate x:Key="ModuleRow">
            <DockPanel Margin="0,1">
                <TextBlock x:Name="Eng" DockPanel.Dock="Right" Text="{Binding eng}" FontSize="11" Margin="8,0,0,0"
                           Foreground="{StaticResource Purple}" TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                <TextBlock x:Name="Name" Text="{Binding name}" FontSize="12" Foreground="{StaticResource HudText}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
            <DataTemplate.Triggers>
                <!-- switched off in the right-hand panel -->
                <DataTrigger Binding="{Binding off}" Value="True">
                    <Setter TargetName="Name" Property="Foreground" Value="{StaticResource HudDim}"/>
                    <Setter TargetName="Name" Property="TextDecorations" Value="Strikethrough"/>
                </DataTrigger>
                <!-- damaged -->
                <DataTrigger Binding="{Binding damaged}" Value="True">
                    <Setter TargetName="Name" Property="Foreground" Value="{StaticResource Danger}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="Margin" Value="0,6,0,1"/>
            <Setter Property="Foreground" Value="{StaticResource Hud}"/>
        </Style>
    </StackPanel.Resources>

    <!-- Name line -->
    <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource HudText}" TextTrimming="CharacterEllipsis">
        <Run Text="{Binding Game.Ship, Mode=OneWay}"/>
        <Run Text="{Binding Game.ShipName, Mode=OneWay}" Foreground="{StaticResource Hud}"/>
        <Run Text="{Binding V[ident], Mode=OneWay}" Foreground="{StaticResource HudDim}" FontSize="11"/>
    </TextBlock>

    <!-- Fuel and hull (straight from the game state) -->
    <DockPanel Margin="0,6,0,0">
        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Label}" Text="{Binding Game.FuelText}"/>
        <TextBlock Style="{StaticResource Label}" Text="{T ui.fuel}"/>
    </DockPanel>
    <ProgressBar Style="{StaticResource Bar}" Value="{Binding Game.FuelPercent, Mode=OneWay}"/>
    <DockPanel>
        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Label}" Text="{Binding Game.HullPercent, StringFormat={}{0:0}%}"/>
        <TextBlock Style="{StaticResource Label}" Text="{T ui.hull}"/>
    </DockPanel>
    <ProgressBar Style="{StaticResource Bar}" Foreground="{StaticResource Danger}" Value="{Binding Game.HullPercent, Mode=OneWay}"/>
    <!-- Shields: the game only says up or down (no percentage) -->
    <DockPanel Margin="0,4,0,2" Visibility="{Binding Game.ShieldsApply, Converter={StaticResource BoolToVis}}">
        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Label}" Text="{Binding Game.ShieldsDetail}" VerticalAlignment="Center"/>
        <TextBlock Style="{StaticResource Label}" Text="{T ui.shields}" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding Game.ShieldsText}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Game.ShieldsUp}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Ok}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </DockPanel>

    <!-- Pips -->
    <Grid Margin="0,4,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,6,0">
            <TextBlock Style="{StaticResource Label}" Text="{T ui.sys}"/>
            <ProgressBar Style="{StaticResource Bar}" Maximum="4" Value="{Binding Game.PipSys, Mode=OneWay}" Foreground="{StaticResource Ok}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="3,0">
            <TextBlock Style="{StaticResource Label}" Text="{T ui.eng}"/>
            <ProgressBar Style="{StaticResource Bar}" Maximum="4" Value="{Binding Game.PipEng, Mode=OneWay}"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Margin="6,0,0,0">
            <TextBlock Style="{StaticResource Label}" Text="{T ui.wep}"/>
            <ProgressBar Style="{StaticResource Bar}" Maximum="4" Value="{Binding Game.PipWep, Mode=OneWay}" Foreground="{StaticResource Danger}"/>
        </StackPanel>
    </Grid>

    <!-- Numbers: two from the game state, two from the script -->
    <UniformGrid Columns="4" Margin="0,8,0,0">
        <StackPanel>
            <TextBlock Style="{StaticResource Label}" Text="{T ui.jump}"/>
            <TextBlock Style="{StaticResource Value}" FontSize="13" Text="{Binding Game.JumpRangeText}"/>
        </StackPanel>
        <StackPanel>
            <TextBlock Style="{StaticResource Label}" Text="{T ui.cargo}"/>
            <TextBlock Style="{StaticResource Value}" FontSize="13" Text="{Binding Game.CargoText}"/>
        </StackPanel>
        <StackPanel>
            <TextBlock Style="{StaticResource Label}" Text="{T ui.value}"/>
            <TextBlock Style="{StaticResource Value}" FontSize="13" Text="{Binding V[value]}"/>
        </StackPanel>
        <StackPanel>
            <TextBlock Style="{StaticResource Label}" Text="{T ui.rebuy}"/>
            <TextBlock x:Name="Rebuy" FontSize="13" FontWeight="SemiBold" Text="{Binding V[rebuy]}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource Good}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding V[cantAffordRebuy]}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </UniformGrid>
    <TextBlock Text="{Binding V[rebuyNote]}" Foreground="{StaticResource Danger}" FontSize="11" FontWeight="Bold" TextWrapping="Wrap"/>

    <!-- The loadout (scrolls when the module is small; drag its bottom edge to see more) -->
    <TextBlock Text="{Binding V[waiting]}" FontStyle="Italic" FontSize="12" Foreground="{StaticResource HudDim}" Margin="0,6,0,0" TextWrapping="Wrap"/>
    <ItemsControl MaxHeight="320">
        <ItemsControl.Template>
            <ControlTemplate TargetType="ItemsControl">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer>
            </ControlTemplate>
        </ItemsControl.Template>
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <!-- each section: a title + its modules (from set("sections", [{ title, modules: […] }, …])) -->
        <ItemsControl.ItemsSource>
            <Binding Path="V[sections]"/>
        </ItemsControl.ItemsSource>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <StackPanel>
                    <TextBlock Style="{StaticResource Section}" Text="{Binding title}"/>
                    <ItemsControl ItemsSource="{Binding modules}" ItemTemplate="{StaticResource ModuleRow}"/>
                </StackPanel>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</StackPanel>
