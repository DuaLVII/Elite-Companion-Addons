<!-- Credits: one of the app's own modules, made as an addon so it can be restyled, translated or used as a
     starting point (copy the folder and rename it). The charts draw from the series the app records itself. -->
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:controls="clr-namespace:EliteCompanion.Controls">
    <!-- Balance and profit: stacked, side by side when the module is wide -->
    <UniformGrid Columns="1" controls:Responsive.WideColumns="2">
        <controls:TimeSeriesChart Series="balance" Height="130" Margin="0,0,4,6"/>
        <controls:TimeSeriesChart Series="profit" Height="130" Margin="0,0,4,0"/>
    </UniformGrid>
</StackPanel>
